# LLM Lab settings. Copy this file to .env and fill in what you use: cp .env.example .env
#
# python/settings.py is the full list of what is read, with what each value does. A variable already set in your shell
# wins over this file. Never commit .env: it holds your key, and values that are only true for your machine.
#
# Lines that are set below are the local defaults: the lab runs with them as they are. Lines that are commented out are
# placeholders (Azure resources, keys, your own phone or email): uncomment one only once you have a real value for it.
# `azd up` writes the Azure values into .env for you (infra/hooks/write_env.py).

# ----- Claude -----
# The only key the lab needs. The Anthropic SDK reads it itself.
ANTHROPIC_API_KEY=sk-ant-your-key-here
LLM_LAB_MODEL=claude-haiku-5-5
# 429 or 529 after the SDK's retries: auto (a GPT deployment, or the local model), none, or a model id.
LLM_LAB_RATE_LIMIT_FALLBACK=auto

# ----- The backend -----
# `python -m backend --port ... --budget ...` sets the first two for you.
LLM_LAB_PORT=8000
LLM_LAB_BUDGET=2.0
LLM_LAB_DEV_PORT=5173
# Chrome for the site builder's screenshots, if it is not in a usual place.
# LLM_LAB_CHROME=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# ----- Open models on this machine (tools/local-model.sh) -----
# Set LLM_LAB_LOCAL_MODEL to make an open model the default wherever Claude-only features are not needed.
# LLM_LAB_LOCAL_MODEL=ai/qwen3.5:9b-q4_K_XL
LLM_LAB_LOCAL_URL=http://localhost:12434/anthropic
LLM_LAB_LOCAL_OPENAI_URL=http://localhost:12434/engines/v1
LLM_LAB_LOCAL_CONTEXT=32768
# LLM_LAB_LOCAL_EMBED_MODEL=ai/nomic-embed-text-v1.5

# ----- Vector database (tools/vector-db.sh starts it in Docker) -----
LLM_LAB_PGVECTOR_URL=postgresql://lab:lab@127.0.0.1:5433/vectors

# ----- The coding agent's sandbox -----
# auto (sandbox-exec on macOS, bubblewrap on Linux), docker (tools/sandbox.sh), sessions (Azure), container or none.
LLM_LAB_SANDBOX=auto
LLM_LAB_DOCKER_SANDBOX_URL=http://127.0.0.1:8099
# For LLM_LAB_SANDBOX=sessions (written by azd):
# LLM_LAB_SESSIONS_ENDPOINT=https://<region>.dynamicsessions.io/subscriptions/<subscription-id>/resourceGroups/<group>/sessionPools/<pool>
# LLM_LAB_SESSIONS_SCOPE=

# ----- Azure: GPT, embeddings and search (keyless: sign in with az login) -----
# AZURE_OPENAI_ENDPOINT=https://<your-ai-services>.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENTS=<gpt-deployment>,<another-deployment>
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=<embedding-deployment>
# AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net

# ----- Microsoft Foundry (keyless) -----
# FOUNDRY_PROJECT_ENDPOINT=https://<your-ai-services>.services.ai.azure.com/api/projects/<project>
# FOUNDRY_MODEL=<model-deployment>

# ----- Foundry Tools: Language, Speech, media (keyless) -----
# AZURE_LANGUAGE_ENDPOINT=https://<your-ai-services>.cognitiveservices.azure.com/
# AZURE_MEDIA_ENDPOINT=https://<your-second-ai-services>.cognitiveservices.azure.com/
# AZURE_AI_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/<group>/providers/Microsoft.CognitiveServices/accounts/<name>
# AZURE_MEDIA_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/<group>/providers/Microsoft.CognitiveServices/accounts/<name>
# The tutor's voice: a resource ID signed in with az login (preferred), or a key and region.
# AZURE_SPEECH_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/<group>/providers/Microsoft.CognitiveServices/accounts/<name>
# AZURE_SPEECH_FALLBACK_RESOURCE_ID=
# AZURE_SPEECH_REGION=uksouth
# AZURE_SPEECH_KEY=<your-speech-key>
# Personal voice is limited access, and not offered in uksouth.
# AZURE_PERSONAL_VOICE_RESOURCE_ID=
AZURE_PERSONAL_VOICE_REGION=swedencentral

# ----- MedAssist, the hotel agent and Aftercare: real texts, emails and calls -----
# The patients and guests are invented, so real messages go only to your own phone or inbox.
# MEDASSIST_SMS_ENDPOINT=https://<your-communication-services>.communication.azure.com
# MEDASSIST_REMINDERS_TABLE=https://<your-storage>.table.core.windows.net/<table>
# MEDASSIST_SMS_TO=+44<your-mobile>
MEDASSIST_SMS_SENDER=Durjan Lab
MEDASSIST_PHONE_PATIENT=P002
# MEDASSIST_PHONE_TOKEN=<made-by-setup-phone-line.sh>
# MEDASSIST_PHONE_LANGUAGE=pl
# HOTEL_SMS_TO=+44<your-mobile>
# HOTEL_EMAIL_TO=<you>@example.com
# HOTEL_EMAIL_SENDER=DoNotReply@<your-connected-domain>
# AFTERCARE_CALLER_ID=+44<a-number-in-your-resource>
# AFTERCARE_CALL_TO=+44<your-mobile>
# AFTERCARE_CALLBACK_URL=https://<your-dev-tunnel>.devtunnels.ms
# AFTERCARE_SPEECH_ENDPOINT=https://<your-ai-services>.cognitiveservices.azure.com/
# ORDER_API_URL=https://<your-order-api>

# ----- /model-failover -----
# History: files under generated/ unless one of these is set. Storage is keyless; a connection string is accepted only
# for Azurite's development string.
# MODEL_FAILOVER_STORAGE_ACCOUNT=<your-storage-account>
# MODEL_FAILOVER_BLOB_ENDPOINT=https://<your-storage>.blob.core.windows.net
# MODEL_FAILOVER_TABLE_ENDPOINT=https://<your-storage>.table.core.windows.net
# MODEL_FAILOVER_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
# Compaction
MODEL_FAILOVER_COMPACT_AT=0.7
MODEL_FAILOVER_COMPACT_MAX_TOKENS=60000
MODEL_FAILOVER_KEEP_RECENT=4
# Empty: the catalog's compact_model.
MODEL_FAILOVER_COMPACT_MODEL=
# Limits and the router
MODEL_FAILOVER_MAX_TOKENS=1024
MODEL_FAILOVER_SUMMARY_MAX_TOKENS=700
MODEL_FAILOVER_MAX_ITERATIONS=6
MODEL_FAILOVER_COOLDOWN_S=30
MODEL_FAILOVER_MAX_COOLDOWN_S=300
MODEL_FAILOVER_SHORT_RETRY_S=2
# The model list: file (config/model-failover.json) or table (Azure Table Storage, in the history's account)
MODEL_FAILOVER_CATALOG=file
MODEL_FAILOVER_CATALOG_PATH=config/model-failover.json
MODEL_FAILOVER_CATALOG_TTL_S=30

# ----- /voice-agent -----
VOICE_AGENT_END_SILENCE_MS=700
VOICE_AGENT_EAGER_THRESHOLD=0.6
VOICE_AGENT_VOICE=en-GB-SoniaNeural
VOICE_AGENT_EXPRESSIVENESS=2
VOICE_AGENT_LOCAL_TTS_PORT=8098
VOICE_AGENT_MAX_CONVERSATIONS=20
